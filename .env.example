# 프로젝트 환경 변수는 이 파일 하나로 관리한다. `cp .env.example .env` 후 필요한 값만 바꾼다.
# 코드·compose에는 기본값이 없다. 빈 값으로 둬도 되는 건 주석에 적었다. 나머지가 없으면 실행되지 않는다.
# 읽는 곳: docker compose(`${...}` 치환) · backend(로컬 uvicorn) · frontend(로컬 Vite)

# ── docker compose 호스트 포트 ───────────────────────
# 다른 프로젝트와 겹칠 때 바꾼다. DB_PORT는 아래 DATABASE_URL에도 쓰인다.
FRONTEND_PORT=5173
BACKEND_PORT=8000
DB_PORT=5432

# ── DB ──────────────────────────────────────────────
# 이미 만들어진 db-data 볼륨에는 반영되지 않으니 바꾸면 `docker compose down -v` 후 다시 띄운다. (DB 데이터 삭제됨)
POSTGRES_DB=ai_playground
POSTGRES_USER=playground
POSTGRES_PASSWORD=playground

# ── backend ────────────────────────────────────────
# 로컬에서 uvicorn을 직접 띄울 때 쓴다. Docker에서는 compose가 위 DB 값으로 따로 만든다.
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${DB_PORT}/${POSTGRES_DB}

# JWT 서명 키. 운영에서는 반드시 랜덤 값으로 바꾼다. (예: openssl rand -hex 32)
JWT_SECRET=dev-secret-change-me

# 추가로 허용할 CORS 출처. 쉼표로 구분하고, localhost:5173은 항상 허용된다. (비워 둬도 됨)
CORS_ORIGINS=

# Claude API 키 (WHY? 설명 등 AI 기능용). https://console.anthropic.com 에서 발급한다. (비우면 AI 기능 꺼짐)
ANTHROPIC_API_KEY=

# Claude 모델과 effort. 이 파일에서만 정한다. (코드·compose에 기본값 없음)
# 모델: claude-haiku-5-5(저렴·빠름) · claude-sonnet-5-5 · claude-opus-5-5(고성능)
ANTHROPIC_MODEL=claude-haiku-5-5
# 생각 깊이: low · medium · high · xhigh · max (높을수록 꼼꼼하지만 비용·응답 시간 증가)
ANTHROPIC_EFFORT=medium

# ── frontend ───────────────────────────────────────
# 로컬 Vite 개발 서버가 /api 요청을 넘길 주소. Docker에서는 compose가 http://backend:8000으로 넘긴다.
VITE_API_PROXY=http://localhost:8000
# 파일 변경 이벤트가 안 오는 환경에서 true. Docker에서는 compose가 true로 넘긴다. (비우면 false)
CHOKIDAR_USEPOLLING=false
